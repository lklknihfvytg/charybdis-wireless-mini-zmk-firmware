+static int pmw3610_pm_action(const struct device *dev, enum pm_device_action action) {
+    switch (action) {
+    case PM_DEVICE_ACTION_SUSPEND:
+        return pmw3610_set_interrupt(dev, false);
+    case PM_DEVICE_ACTION_RESUME:
